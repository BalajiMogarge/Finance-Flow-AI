# ==============================================================================
# Finance Flow AI — Backend Environment Variables (.env.example)
# Target Architecture: Render (FastAPI Docker) + Neon Postgres + S3 Storage
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# ------------------------------------------------------------------------------
# Valid options: development, test, production
# NOTE: If set to 'production', STORAGE_BACKEND must be 's3' and SECRET_KEY must be >= 32 chars.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Database Connections (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Neon POOLED connection string (PgBouncer mode, used at runtime)
# Format: postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://finance_flow_user:finance_flow_pass@localhost:5432/finance_flow

# DATABASE_URL_DIRECT: Neon DIRECT (non-pooled) connection string (used ONLY by Alembic migrations)
# Format: postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL_DIRECT=postgresql://finance_flow_user:finance_flow_pass@localhost:5432/finance_flow

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for JWT token signing. Must be at least 32 characters long.
# Generate with: openssl rand -hex 32 (or Python: secrets.token_hex(32))
SECRET_KEY=change-this-to-a-secure-random-secret-key-with-at-least-32-chars!

# JWT signing algorithm (default: HS256)
ALGORITHM=HS256

# JWT token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. CORS & Frontend Origin Authorization
# ------------------------------------------------------------------------------
# Comma-separated list of explicitly permitted frontend web origins
FRONTEND_ORIGINS=https://finance-flow-ai.vercel.app,http://localhost:3000,http://localhost:3001

# Optional regex for Vercel preview environments, strictly scoped to this project's prefix
FRONTEND_PREVIEW_REGEX=^https://finance-flow-ai(-[a-zA-Z0-9_-]+)?\.vercel\.app$

# ------------------------------------------------------------------------------
# 5. Object Storage (Neon Object Storage / S3-Compatible Private Bucket)
# ------------------------------------------------------------------------------
# Storage backend: 's3' (required for production) or 'local' (local dev only)
STORAGE_BACKEND=local

# S3-compatible endpoint (e.g. Neon Object Storage or Supabase Storage S3 endpoint)
S3_ENDPOINT_URL=https://your-s3-endpoint.example.com

# S3 region (e.g. us-east-2 or us-east-1)
S3_REGION=us-east-2

# S3 credentials with access to the private bucket
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# Private bucket name (originals are served only via short-lived presigned URLs)
S3_BUCKET=uploads

# Local storage folder (used only when STORAGE_BACKEND=local)
UPLOAD_DIR=uploads

# Maximum allowed upload payload size in bytes (default: 10485760 = 10 MB)
MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------------------------
# 6. OCR & Async Processing Configuration (RapidOCR ONNX Runtime CPU)
# ------------------------------------------------------------------------------
# Maximum concurrent OCR inferences (tuned for 512MB RAM instance: default 1)
OCR_CONCURRENCY=1

# Image dimension cap (width/height) before Lanczos downscaling is applied (default: 1600px)
OCR_MAX_IMAGE_DIM=1600

# Hard per-job timeout in seconds for background processing pipeline (default: 90)
OCR_TIMEOUT_SECONDS=90
