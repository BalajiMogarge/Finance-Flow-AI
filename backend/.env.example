# ==============================================================================
# Finance Flow AI — Backend Production Environment Variables (.env.example)
# Target Architecture: Render (FastAPI Docker) + Neon Postgres + Supabase S3
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# ------------------------------------------------------------------------------
# Set to 'production' for deployed environments.
# In production, STORAGE_BACKEND must be 's3' and SECRET_KEY must be >= 32 characters.
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. Database Connections (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Neon POOLED connection string (used by FastAPI runtime via PgBouncer)
# Host MUST contain '-pooler.' to enable connection pooling and scale-to-zero wakeups.
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# DATABASE_URL_DIRECT: Neon DIRECT (unpooled) connection string (used by Alembic migrations)
# Host MUST NOT contain '-pooler.' because Alembic migration DDL and locks require direct connection.
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens. Must be >= 32 characters.
# Generate on Windows PowerShell:
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [BitConverter]::ToString($bytes).Replace('-','').ToLower()
SECRET_KEY=replace-with-a-64-char-random-hex-secret-generated-via-powershell

# JWT algorithm (default: HS256)
ALGORITHM=HS256

# JWT token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. CORS & Allowed Frontend Origins
# ------------------------------------------------------------------------------
# Comma-separated list of explicit frontend origins (NO trailing slashes!)
# Update this with your final Vercel deployment URL (e.g. https://finance-flow-ai.vercel.app)
FRONTEND_ORIGINS=https://finance-flow-ai.vercel.app,http://localhost:3000

# Scoped regex pattern matching Vercel preview environments
FRONTEND_PREVIEW_REGEX=^https://finance-flow-ai(-[a-zA-Z0-9_-]+)*\.vercel\.app$

# ------------------------------------------------------------------------------
# 5. Object Storage (Supabase Storage — S3-Compatible Private Bucket)
# ------------------------------------------------------------------------------
# Storage backend: 's3' (required for production) or 'local' (local development only)
STORAGE_BACKEND=s3

# Supabase Storage S3 endpoint URL. MUST end with '/storage/v1/s3'.
# Find your Project Reference ID in Supabase -> Project Settings -> General.
# Format: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3

# Supabase Storage S3 Region (matches your project region, e.g. us-east-1 or ap-southeast-1)
S3_REGION=us-east-1

# Private bucket name created in Supabase Storage (e.g. 'invoices')
S3_BUCKET=invoices

# S3 Access Keys generated in Supabase:
# Supabase Dashboard -> Project Settings -> Storage -> S3 Access Keys -> Generate new key
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key

# Maximum allowed upload payload size in bytes (default: 10485760 = 10 MB)
MAX_UPLOAD_BYTES=10485760

# Local storage fallback directory (ignored when STORAGE_BACKEND=s3)
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 6. OCR & Memory Controls (Tuned for Render 512MB RAM Free Tier)
# ------------------------------------------------------------------------------
# Maximum concurrent OCR jobs (strictly 1 on Render 512MB RAM to prevent OOM kills)
OCR_CONCURRENCY=1

# Maximum dimension (width/height) before Lanczos downscaling is applied (1200px guarantees < 400MB RAM)
OCR_MAX_IMAGE_DIM=1000

# Hard per-job timeout in seconds for background processing
OCR_TIMEOUT_SECONDS=240
