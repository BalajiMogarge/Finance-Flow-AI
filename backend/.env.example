# ==============================================================================
# Finance Flow AI — Backend Environment Variables
# ==============================================================================

# Database: SQLite for local dev/testing, PostgreSQL for production on Render/Neon
DATABASE_URL=sqlite:///finance_flow.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CORS: Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Regex pattern to match Vercel deployment URLs (e.g. *.vercel.app)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Uploads & Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Durable Cloud Storage (Optional - set to 's3' to enable Cloudflare R2 / AWS S3)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=finance-flow-invoices
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_REGION=auto

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Resource / OCR Limits (tuned for Render free-tier 512 MB memory limit)
OCR_CONCURRENCY_LIMIT=1
OCR_MAX_IMAGE_DIM=1600
