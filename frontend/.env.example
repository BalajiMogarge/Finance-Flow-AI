# ==============================================================================
# Finance Flow AI — Frontend Environment Variables (.env.example)
# Target Architecture: Next.js 15 on Vercel connecting to Render FastAPI
# ==============================================================================

# Backend API Base URL (no trailing slash)
# For local dev without Docker: http://localhost:8000
# For local dev with Docker Compose: http://localhost:8000
# For production on Vercel: set to your Render Web Service URL (e.g. https://finance-flow-api.onrender.com)
# NOTE: Required in production builds. If missing, production API calls fail loudly.
NEXT_PUBLIC_API_URL=http://localhost:8000
