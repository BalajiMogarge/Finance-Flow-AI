# ==============================================================================
# Finance Flow AI — Frontend Environment Variables (.env.example)
# Target Architecture: Next.js 15 on Vercel connecting to Hugging Face Spaces
# ==============================================================================

# Backend API Base URL (no trailing slash)
# For local dev with Docker Compose: http://localhost:7860
# For production on Vercel: set to your Hugging Face Space URL (e.g. https://username-space-name.hf.space)
# NOTE: Required in production builds. If missing, production API calls fail loudly.
NEXT_PUBLIC_API_URL=http://localhost:7860
