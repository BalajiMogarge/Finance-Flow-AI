# ==============================================================================
# Finance Flow AI — Frontend Environment Variables (.env.example)
# Target Architecture: Next.js 15 App Router on Vercel
# ==============================================================================

# Backend API Base URL (NO trailing slash!)
# Local Development: http://localhost:8000
# Production on Vercel: Set this in your Vercel Project Settings -> Environment Variables
# Example: https://finance-flow-api.onrender.com
NEXT_PUBLIC_API_URL=https://your-render-backend-url.onrender.com
